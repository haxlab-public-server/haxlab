{
  "name": "haxlab",
  "private": true,
  "version": "0.1.0",
  "description": "Public HaxBall room bot — real headless Chromium via Puppeteer, room logic bundled and injected into the page",
  "main": "HaxBot_public.js",
  "scripts": {
    "start": "node HaxBot_public.js",
    "start:bff": "node HaxBotBFF_public.js",
    "test": "node HaxBot_test.js",
    "check": "node tools/check-all.js",
    "check:deps": "node tools/check-module-deps.js",
    "check:parity": "node tools/audit-parity.js",
    "test:smoke": "node tools/smoke-test.js",
    "build:bundle": "node tools/build-bundle.js"
  },
  "dependencies": {
    "discord.js": "^14.27.0",
    "esbuild": "^0.28.1",
    "node-telegram-bot-api": "^1.2.0",
    "openskill": "^5.0.1",
    "puppeteer": "^25.3.0",
    "socks": "^2.8.9",
    "socks-proxy-agent": "^10.1.0",
    "undici": "^6.28.0"
  },
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "acorn": "^8.17.0",
    "acorn-walk": "^8.3.5"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "puppeteer@25.3.0": true
  }
}
