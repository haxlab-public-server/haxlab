# Copy this file to .env and fill in real values. .env itself is gitignored
# and never committed — this file is just the template.

# HaxBall headless token from https://www.haxball.com/headlesstoken.
# Valid for about an hour — get a fresh one right before starting the bot.
HAXBALL_TOKEN=

# Room join password. Leave empty for no password.
ROOM_PASSWORD=

# Discord bot token from the Discord Developer Portal (Bot tab).
# Requires the "Message Content" AND "Server Members" privileged intents
# enabled there (Bot > Privileged Gateway Intents).
DISCORD_TOKEN=

# Channel that gets join/leave/kick/chat/goal logs — private channel recommended.
DISCORD_LOG_CHANNEL_ID=

# Channel that gets match summaries and recordings — public channel recommended.
DISCORD_REPORT_CHANNEL_ID=

# Your Discord user ID. Messages you send (via !say or /say) are relayed into
# the room chat. Find it via Discord Developer Mode -> right-click yourself ->
# Copy User ID.
DISCORD_OWNER_ID=

# Server members with this role can also use !say/`/say` to relay messages
# into the room chat, alongside the owner (every other command stays
# owner-only). Find it the same way as DISCORD_AUTO_ROLE_ID below. Leave
# empty to keep !say/`/say` owner-only.
DISCORD_ADMIN_ROLE_ID=

# Role automatically given to every new server member on join. Find it via
# Discord Developer Mode -> Server Settings -> Roles -> right-click the role
# -> Copy Role ID. Leave empty to disable auto-role.
DISCORD_AUTO_ROLE_ID=

# Role synced both ways with room VIP (!setvip/!removevip), for a member who
# has linked their HaxBall account via !discord in the room:
#   - Room VIP granted (!setvip, or the 4v4-win lottery) -> role added.
#   - Room VIP removed, by !removevip or by its own expiry -> role removed.
#   - Role given to a member on Discord -> grants their linked auth room VIP.
#   - Role removed on Discord -> does NOT revoke room VIP (use !removevip).
# Granting/removing the role for someone unlinked does nothing until they
# link. A reconciliation pass also runs on every bot (re)connect, to catch
# any drift from downtime (e.g. an expiry the bot missed while offline).
# Find it via Discord Developer Mode -> Server Settings -> Roles ->
# right-click the role -> Copy Role ID. Leave empty to disable.
DISCORD_VIP_ROLE_ID=

# Dedicated channel for a single live "join the room" message (player count +
# a "Присоединиться" link button), kept updated in place. Leave empty to
# disable it — the bot still shows the same info in its own Discord status.
DISCORD_STATUS_CHANNEL_ID=

# Channel that gets the auto-rotated overflow room password (posted once the
# room fills to maxPlayers - 2, rotated hourly, cleared when it drops back
# below that). Leave empty to disable posting it (the password still gets set
# on the room either way).
DISCORD_PASSWORD_CHANNEL_ID=

# Channel that gets an @here ping whenever a player uses !report in the room
# (1-minute cooldown per player). Needs the bot to have "Mention @everyone,
# @here, and All Roles" permission in that channel, or the ping won't fire.
# Leave empty to disable posting it (the in-room announcement still happens
# either way).
DISCORD_ADMIN_CALL_CHANNEL_ID=

# Channel that gets a notification whenever a !voteban vote actually passes
# and bans someone. Leave empty to disable posting it (the ban and in-room
# announcement still happen either way).
DISCORD_VOTEBAN_CHANNEL_ID=

# Name to watch for as "@<name>" (case-insensitive) in room chat — whenever
# it appears anywhere in a message, the whole message + who sent it gets
# posted to DISCORD_MENTION_ALERT_CHANNEL_ID below, pinging DISCORD_OWNER_ID.
# Leave empty to disable the whole feature.
MENTION_WATCH_NAME=

# Channel that gets the @-ping described above. Leave empty to disable
# posting it even if MENTION_WATCH_NAME is set.
DISCORD_MENTION_ALERT_CHANNEL_ID=

# Optional SOCKS5 proxy for the Discord bot's own connection to Discord
# (REST API + gateway), e.g. socks5://user:pass@host:port. Only used by the
# separate Discord process (discordProcess.js) — never affects the room /
# Puppeteer connection, which HaxBall players actually ride on. Leave empty
# to connect to Discord directly.
DISCORD_PROXY_URL=
